{
  "name": "sqlguard-pro",
  "version": "1.0.0",
  "description": "Professional SQL vulnerability scanner for Cascade SWE-1.5",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "start": "node dist/main.js",
    "analyze": "node dist/main.js analyze",
    "scan": "node dist/main.js scan"
  },
  "keywords": [
    "sql",
    "security",
    "vulnerability",
    "scanner",
    "static-analysis",
    "cascade",
    "swe-1.5",
    "injection",
    "database",
    "audit"
  ],
  "author": "SQLGuard Pro Team",
  "license": "MIT",
  "dependencies": {
    "node-sql-parser": "^4.17.0",
    "openai": "^4.20.1",
    "ajv": "^8.12.0",
    "lodash": "^4.17.21",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "@tensorflow/tfjs-node": "^4.10.0",
    "dockerode": "^3.3.5",
    "uuid": "^9.0.1",
    "puppeteer": "^21.0.0",
    "sharp": "^0.32.0",
    "ws": "^8.13.0",
    "jsonwebtoken": "^9.0.2",
    "express": "^4.18.2",
    "cli-table3": "^0.6.3",
    "bcryptjs": "^2.4.3",
    "glob": "^10.3.0",
    "fs-extra": "^11.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.40",
    "@types/jest": "^29.5.5",
    "@types/lodash": "^4.14.199",
    "@types/uuid": "^9.0.7",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/glob": "^8.1.0",
    "@types/fs-extra": "^11.0.4",
    "@typescript-eslint/eslint-plugin": "^6.7.4",
    "@typescript-eslint/parser": "^6.7.4",
    "eslint": "^8.50.0",
    "prettier": "^3.0.3",
    "ts-jest": "^29.1.1",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sqlguard/sqlguard-pro.git"
  },
  "bugs": {
    "url": "https://github.com/sqlguard/sqlguard-pro/issues"
  },
  "homepage": "https://sqlguard-pro.com",
  "bin": {
    "sqlguard": "dist/cli.js"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ]
}
