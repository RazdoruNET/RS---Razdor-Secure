#!/usr/bin/env python3
# Simplified Dockerfile for testing proxy daemon functionality

FROM python:3.10-slim

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV DEBIAN_FRONTEND=noninteractive

# Set work directory
WORKDIR /app

# Install basic dependencies
RUN apt-get update && apt-get install -y \
    net-tools \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy stage 3 components from local directories
COPY src/proxy_daemon_fixed.py /app/proxy_daemon_working.py
COPY src/verification/destination_extractor_final.py /app/
COPY src/verification/tcp_segment_working.py /app/verification/

# Create necessary directories
RUN mkdir -p /app/logs /app/data /app/config

# Set permissions
RUN chmod +x /app/proxy_daemon_working.py

# Copy simplified entrypoint script
COPY entrypoint_simple.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

# Set environment variables
ENV CHUNK_SIZE=30
ENV CHUNK_DELAY=0.005
ENV LISTEN_PORT=1080
ENV LOG_LEVEL=INFO

# Expose proxy port
EXPOSE 1080

# Set entrypoint
ENTRYPOINT ["/app/entrypoint.sh"]
